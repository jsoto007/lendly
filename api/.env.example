# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/lendly_dev
JWT_SECRET=change-me-in-production
APPLE_BUNDLE_ID=com.sotodev.lendly
# When true, email login codes are returned in the API response instead of emailed (local dev only).
DEV_RETURN_OTP=true
PORT=5050
# Login-code emails (required in production; leave unset locally and DEV_RETURN_OTP=true returns the code instead)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.sotodev.com
MAILGUN_FROM=Lendly <no-reply@sotodev.com>
MAILGUN_BASE_URL=https://api.mailgun.net
# Login-code limits: codes per address per window, and requests per client IP per window.
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_MINUTES=10
OTP_IP_LIMIT=20
# App Review demo account (production only): fixed 8-12 digit code for one address, nothing e-mailed.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=
