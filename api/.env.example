# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/lendly_dev
JWT_SECRET=change-me-in-production
APPLE_BUNDLE_ID=com.sotodev.lendly
# When true, email login codes are returned in the API response instead of emailed (local dev only).
DEV_RETURN_OTP=true
PORT=5050
